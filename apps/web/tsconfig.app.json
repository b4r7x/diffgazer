{
  "extends": "../../libs/core/tsconfig/react.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/**/testing/**",
    "src/test-setup.ts",
    "src/vitest.d.ts"
  ]
}
