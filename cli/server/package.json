{
  "name": "@diffgazer/server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/serve.ts",
    "start": "node dist/serve.js",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@diffgazer/core": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.7.6",
    "@napi-rs/keyring": "^1.2.0",
    "hono": "^4.12.34",
    "undici": "^7.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
