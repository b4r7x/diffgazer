// Dead-file / dead-export / unused-dependency sweep that neither Biome nor
// dependency-cruiser performs.
//
// Generated registries, docs fixtures, and package entry contracts are
// intentionally configured here so `pnpm run knip` reports actionable drift
// instead of public handoff surfaces.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "treatConfigHintsAsErrors": true,
  "ignoreDependencies": [
    "@arethetypeswrong/cli",
    "@types/diff",
    "@types/figlet",
    "@types/hast",
    "@tailwindcss/postcss",
    "commander",
    "diff",
    "figlet",
    "next",
    "postcss",
    "publint",
    "shadcn"
  ],
  "ignoreIssues": {
    "libs/ui/theme/docs-tokens.ts": ["exports", "types"],
    // Dynamic test doubles import this layout helper through a module namespace,
    // which Knip cannot connect to the declaration statically.
    "cli/diffgazer/src/components/layout/global.tsx": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/monorepo/**/*.mjs"],
      // Root scripts dispatch to package scripts by name; `dev` is not an
      // executable dependency.
      "ignoreBinaries": ["dev"]
    },
    "apps/web": {
      "entry": [
        "src/app/routes/**/*.tsx",
        "testing/fixtures/app-fixture.tsx",
        "testing/e2e/start-embedded-production-server.ts",
        "testing/fixtures/theme-contract.tsx",
        "vite.embedded.config.ts"
      ],
      // Ambient matcher declarations: consumed by tsconfig.test.json, never imported.
      "ignore": ["src/vitest.d.ts"]
    },
    "apps/landing": {
      "entry": ["index.html", "src/styles/index.css"],
      "ignoreDependencies": ["@diffgazer/ui"]
    },
    "apps/docs": {
      // The scroll-bootstrap tests pin router internals by resolving
      // @tanstack/router-core through @tanstack/react-router on purpose, so a
      // direct dependency would let the two versions drift apart.
      "ignoreDependencies": ["@tanstack/router-core"],
      "entry": [
        "src/client.tsx",
        "src/server.ts",
        "src/router.tsx",
        "src/routes/**/*.tsx",
        "source.config.ts",
        "scripts/**/*.{ts,mjs,d.mts}"
      ]
    },
    "cli/add": {
      "entry": ["scripts/**/*.ts"],
      "ignoreDependencies": ["@diffgazer/keys", "@diffgazer/ui"]
    },
    "cli/server": {
      // Directory facades: every consumer outside `cli-compatibility/` and
      // `hosted/` imports through these files, and their re-export surface is
      // kept whole rather than pruned to today's callers. Declaring them as
      // entry points keeps Knip from reading an individually-unimported
      // re-export as dead code.
      "entry": [
        "src/shared/lib/ai/providers/cli-compatibility/compat.ts",
        "src/shared/lib/ai/providers/cli-compatibility/probe.ts",
        "src/shared/lib/ai/providers/hosted/transport.ts"
      ]
    },
    "cli/diffgazer": {
      // capture-review-frames is invoked by scripts/parity-capture.mjs via a
      // string path, invisible to import analysis.
      "entry": ["src/testing/capture-review-frames.tsx"],
      "ignoreDependencies": ["@diffgazer/web"],
      "ignoreBinaries": ["taskkill", "vite"]
    },
    "libs/core": {
      "entry": ["src/**/index.ts", "src/*.ts", "scripts/**/*.ts"]
    },
    "libs/keys": {
      "entry": ["scripts/**/*.ts", "registry/**/*.{ts,tsx}"],
      "ignoreFiles": ["docs/hook-docs/**"]
    },
    "libs/ui": {
      // Registry CSS entries are discovered through registry.json file metadata,
      // not TS imports; the artifact validator owns their presence.
      // Listed one by one on purpose: a new stylesheet has to be justified here
      // rather than silently absorbed by a glob.
      "ignoreFiles": [
        "registry/ui/code-block/code-block.css",
        "registry/ui/command-palette/command-palette.css",
        "registry/ui/panel/panel.css",
        "registry/ui/progress/progress.css",
        "registry/ui/shared/dialog.css",
        "registry/ui/shared/overlay-hints.css",
        "registry/ui/shared/stepper.css",
        "registry/ui/sidebar/sidebar.css",
        "registry/ui/skeleton/skeleton.css",
        "registry/ui/spinner/spinner.css"
      ],
      "entry": [
        // Every registry file is a copy-consumer entry point, so knip does no
        // unused-file or unused-export analysis inside registry/ on purpose.
        "registry/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        "testing/fixtures/*.tsx",
        "vite.e2e.config.ts"
      ]
    },
    "libs/registry": {
      "entry": []
    }
  }
}
