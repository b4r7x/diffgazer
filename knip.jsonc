// Dead-file / dead-export / unused-dependency sweep that neither Biome nor
// dependency-cruiser performs.
//
// Generated registries, docs fixtures, package artifact mirrors, and package
// entry contracts are intentionally configured here so `pnpm run knip` reports
// actionable drift instead of public handoff surfaces.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["depcruise", "biome", "turbo", "playwright", "lhci", "dev", "taskkill"],
  "ignoreDependencies": [
    "@arethetypeswrong/cli",
    "@diffgazer/.+",
    "@clack/prompts",
    "@types/diff",
    "@types/figlet",
    "@types/hast",
    "@chialab/vitest-axe",
    "@tailwindcss/postcss",
    "commander",
    "diff",
    "figlet",
    "next",
    "picocolors",
    "postcss",
    "publint",
    "shadcn",
    "tsup",
    "vitest"
  ],
  "ignoreIssues": {
    "libs/registry/src/manifest.ts": ["types"],
    "libs/ui/theme/index.ts": ["exports", "types"]
  },
  // Only build output and generated data belong here. Anything owned by one
  // workspace is ignored in that workspace's own block below, so a path stays
  // next to the package that has to justify it.
  "ignore": [
    "**/dist/**",
    "**/.output/**",
    "**/.turbo/**",
    "**/.source/**",
    "**/coverage/**",
    "**/generated/**",
    "**/*.gen.ts"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/monorepo/**/*.mjs", "scripts/monorepo/**/*.test.mjs"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "src/app/routes/**/*.tsx", "testing/fixtures/results-layout.tsx"]
    },
    "apps/landing": {
      "entry": ["src/main.ts", "index.html"]
    },
    "apps/docs": {
      "entry": [
        "src/client.tsx",
        "src/server.ts",
        "src/router.tsx",
        "src/routes/**/*.tsx",
        "source.config.ts",
        "scripts/**/*.{ts,mjs,d.mts}"
      ]
    },
    "cli/add": {
      "entry": ["src/index.ts", "scripts/**/*.ts", "tsup.config.ts", "vitest.config.ts"]
    },
    "cli/server": {
      "entry": ["src/index.ts", "src/serve.ts", "vitest.config.ts"]
    },
    "cli/diffgazer": {
      // capture-review-frames is invoked by scripts/parity-capture.mjs via a
      // string path, invisible to import analysis.
      "entry": [
        "src/index.tsx",
        "bin/diffgazer.js",
        "tsup.config.ts",
        "vitest.config.ts",
        "src/testing/capture-review-frames.tsx"
      ]
    },
    "libs/core": {
      "entry": ["src/**/index.ts", "src/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
      // Offline catalog data, regenerated from models.dev.
      "ignore": ["src/catalog/catalog-snapshot.ts"]
    },
    "libs/keys": {
      "entry": ["src/index.ts", "scripts/**/*.ts", "registry/**/*.{ts,tsx}", "vitest.config.ts"],
      // Committed public registry: the reviewable handoff contract, not imports.
      "ignore": ["public/r/**"],
      "ignoreFiles": ["docs/hook-docs/**", "examples/playground/**"]
    },
    "libs/ui": {
      // Committed public registry: the reviewable handoff contract, not imports.
      "ignore": ["public/r/**"],
      // Registry CSS entries are discovered through registry.json file metadata,
      // not TS imports; the artifact validator owns their presence.
      // Listed one by one on purpose: a new stylesheet has to be justified here
      // rather than silently absorbed by a glob.
      "ignoreFiles": [
        "registry/ui/callout/callout.css",
        "registry/ui/code-block/code-block.css",
        "registry/ui/command-palette/command-palette.css",
        "registry/ui/diff-view/diff-view.css",
        "registry/ui/panel/panel.css",
        "registry/ui/progress/progress.css",
        "registry/ui/shared/dialog.css",
        "registry/ui/shared/overlay-hints.css",
        "registry/ui/shared/stepper.css",
        "registry/ui/sidebar/sidebar.css",
        "registry/ui/skeleton/skeleton.css",
        "registry/ui/spinner/spinner.css",
        "styles/sources.css",
        "styles/styles.css",
        "styles/theme-base.css",
        "styles/theme.css"
      ],
      "entry": [
        "registry/ui/**/index.ts",
        "registry/hooks/**/*.ts",
        "registry/lib/**/*.ts",
        "registry/**/*.{ts,tsx}",
        "scripts/**/*.ts",
        "tsup.config.ts",
        "testing/fixtures/*.tsx",
        "vite.e2e.config.ts",
        "vitest.config.ts"
      ]
    },
    "libs/registry": {
      "entry": ["src/index.ts", "src/schemas.ts", "src/cli/index.ts", "vitest.config.ts"]
    },
    "libs/keys/artifacts": {
      "entry": ["scripts/**/*.mjs"],
      "ignoreFiles": ["artifacts/source/registry/examples/**"]
    }
  }
}
